{
  "expo": {
    "name": "AI Digital Twin",
    "slug": "ai-digital-twin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.digitaltwin.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The AI Digital Twin needs microphone access to record your voice messages.",
        "NSSpeechRecognitionUsageDescription": "The AI Digital Twin uses speech recognition to understand your voice commands."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.digitaltwin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "The AI Digital Twin needs microphone access to record your voice messages."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "scheme": "ai-digital-twin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ff97cfb-9bc3-4ed6-938e-bb117668cdc8"
      }
    }
  }
}
